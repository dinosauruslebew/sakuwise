# Salin file ini menjadi .env.local lalu isi nilainya.
# Jangan commit .env.local dan jangan isi key asli di file ini.

# --- AI Assistant (wajib agar chat AI berfungsi) ---
# Dapatkan di https://aistudio.google.com (menu "Get API key").
# Jangan pakai awalan NEXT_PUBLIC_ agar key tetap di server.
GEMINI_API_KEY=

# Opsional: model Gemini utama (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Opsional: model cadangan jika model utama sibuk/gagal (default: gemini-3.5-flash)
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# --- Supabase (opsional) ---
# Jika dikosongkan, aplikasi memakai mode simulasi lokal (localStorage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
